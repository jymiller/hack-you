# hack-you — vendor keys. Copy to .env and fill in real values (.env is gitignored).
# NEVER commit real keys. This file holds placeholders only.

# You.com API key (sent as the X-API-Key header).
# One key, two base hosts: Search + Contents at https://ydc-index.io/v1/* ;
# Research (ARI) + Finance at https://api.you.com/v1/*.
YDC_API_KEY=

# AWS — venue is the AWS Builder Loft; deploy target ($25 event credits + Amazon gift-card prizes).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2

# Parasail inference API (OpenAI-compatible). Base URL: https://api.parasail.io/v1
# Sent as the Authorization: Bearer <key> header. Get a key at https://www.saas.parasail.io/keys
PARASAIL_API_KEY=
# Model id to call. Confirm the exact string via GET /v1/models (serverless ids are prefixed
# `parasail-`; HuggingFace-hosted models use the full HF id). Defaults to parasail-deepseek-r1.
PARASAIL_MODEL=

# Port for the Sentinel server (defaults to 8080).
PORT=8080

# Opsera is the $500 side-quest (best use of Opsera Agents) — obtained day-of, no key here.
