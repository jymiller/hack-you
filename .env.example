# hack-you — vendor keys. Copy to .env and fill in real values (.env is gitignored).
# NEVER commit real keys. This file holds placeholders only.

# You.com API key (sent as the X-API-Key header).
# One key, two base hosts: Search + Contents at https://ydc-index.io/v1/* ;
# Research (ARI) + Finance at https://api.you.com/v1/*.
YOU_API_KEY=

# AWS — venue is the AWS Builder Loft ($25 event credits); deploy target.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2

# Novita ($1k won credits, reused). OpenAI-compatible base https://api.novita.ai/openai/v1 .
# Used as the reasoning LLM + DeepSeek-OCR, and as the opencode build harness.
NOVITA_API_KEY=

# ActionLayer ($1k won credits, reused). Last-mile serve-notice rail; PRERUN on stage.
ACTIONLAYER_API_KEY=

# Opsera is booth-only / obtained day-of (optional $500 side bonus) — no key here.
