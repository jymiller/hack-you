{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Module Map Document",
  "type": "object",
  "required": ["type", "name", "display_name", "status"],
  "properties": {
    "type": { "const": "module" },
    "name": { "type": "string" },
    "display_name": { "type": "string" },
    "status": { "enum": ["active", "stable", "deprecated", "experimental"] },
    "file_locations": {
      "type": "object",
      "properties": {
        "entry_points": { "type": "array", "items": { "type": "string" } },
        "controllers": { "type": "array", "items": { "type": "string" } },
        "models": { "type": "array", "items": { "type": "string" } },
        "views": { "type": "array", "items": { "type": "string" } },
        "services": { "type": "array", "items": { "type": "string" } },
        "tests": { "type": "array", "items": { "type": "string" } },
        "config": { "type": "array", "items": { "type": "string" } }
      }
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "count": { "type": "integer" },
          "example": { "type": "string" }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "properties": {
        "internal": { "type": "array", "items": { "type": "string" } },
        "external": { "type": "array", "items": { "type": "string" } },
        "database_tables": { "type": "array", "items": { "type": "string" } }
      }
    },
    "migration": {
      "type": "object",
      "properties": {
        "coupling_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "session_dependencies": { "type": "integer" },
        "global_dependencies": { "type": "integer" },
        "singleton_dependencies": { "type": "array", "items": { "type": "string" } },
        "pattern_consistency": { "type": "number", "minimum": 0, "maximum": 1 },
        "abstraction_boundary": { "enum": ["clean", "partial", "entangled"] },
        "testability": { "enum": ["low", "medium", "high"] },
        "estimated_effort": { "enum": ["small", "medium", "large", "xlarge"] },
        "blockers": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
