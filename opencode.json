{
  "$schema": "https://opencode.ai/config.json",
  "model": "novita-ai/zai-org/glm-5.2",
  "small_model": "novita-ai/deepseek/deepseek-v4-flash",
  "provider": {
    "novita-ai": {
      "name": "Novita (ENID build harness)",
      "npm": "@ai-sdk/openai-compatible",
      "env": ["NOVITA_API_KEY"],
      "options": {
        "baseURL": "https://api.novita.ai/openai/v1",
        "apiKey": "{env:NOVITA_API_KEY}"
      },
      "models": {
        "zai-org/glm-5.2": { "name": "GLM-5.2 — primary coder" },
        "moonshotai/kimi-k2.7-code": { "name": "Kimi K2.7 Code — fallback" },
        "qwen/qwen3-coder-next": { "name": "Qwen3 Coder Next — cheap bulk" },
        "minimax/minimax-m2.7": { "name": "MiniMax M2.7 — cheap reasoning" },
        "deepseek/deepseek-v4-flash": { "name": "DeepSeek V4 Flash — small/title" }
      }
    }
  }
}
